# Copy to .env.local for local development. Never commit real values.

# Session encryption key. Generate with: npx auth secret
AUTH_SECRET=

# OAuth client of the internal Google Workspace app
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Workspace domain that may sign in, e.g. example.com (required, no login without it)
ALLOWED_GOOGLE_DOMAIN=

# Optional: comma-separated list of addresses that may sign in.
# Empty means everyone in the domain.
ALLOWED_EMAILS=

# Optional: without a key the chat answers with a fixed placeholder text
ANTHROPIC_API_KEY=
